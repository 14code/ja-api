{
    "name": "14code/ja-api",
    "description": "Just another API",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "David Hoppe",
            "email": "dh@14co.de"
        }
    ],
    "autoload": {
        "psr-4": {
            "I4code\\JaApi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        },
        "exclude-from-classmap": [
            "tests/assets/"
        ],
        "files": [
            "tests/assets/classes/TestClass.php",
            "tests/assets/classes/TestController.php"
        ]
    },
    "prefer-stable": true,
    "require": {
        "nyholm/psr7": "^1.2",
        "nyholm/psr7-server": "^1",
        "middlewares/fast-route": "^1.2",
        "middlewares/request-handler": "^1.4",
        "symfony/serializer": "^4.3",
        "laminas/laminas-httphandlerrunner": "^1.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^9"
    }
}
